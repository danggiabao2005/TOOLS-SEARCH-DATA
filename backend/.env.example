# Academic PICO Extractor — Backend environment

# LLM: gemini (free) | openai
LLM_PROVIDER=gemini

# Gemini — lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# OpenAI (tuỳ chọn — chỉ cần nếu LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# External APIs
UNPAYWALL_EMAIL=your.email@university.edu
CROSSREF_MAILTO=your.email@university.edu
SEMANTIC_SCHOLAR_API_KEY=
# Google Scholar qua SerpAPI (không có thì nguồn này bị bỏ qua)
SERPAPI_KEY=
# IEEE Xplore Metadata API (tuỳ chọn — không có thì fallback OpenAlex/Crossref)
IEEE_XPLORE_API_KEY=

# Server
API_HOST=0.0.0.0
API_PORT=8000
HTTP_TIMEOUT=30.0
MAX_RETRIES=3
DEFAULT_LIMIT_PER_SOURCE=20
FUZZY_TITLE_THRESHOLD=90.0
